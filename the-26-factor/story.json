      "steps": [
        {
          "id": "s-26f00m",
          "visual": "v-26f00j",
          "number": "",
          "body": "One square on the calendar. Nothing about it is different from the twenty-five before it or the five after.",
          "align": "left",
          "state": {}
        },
        {
          "id": "s-26f00n",
          "visual": "v-26f00j",
          "number": "",
          "body": "And yet twenty-two separate catastrophes — earthquakes, tsunamis, floods, a reactor fire, a siege, a mine explosion — have fallen on it since 1930.",
          "align": "left",
          "state": {
            "zoom": 1.5,
            "focal": "68% 74%"
          }
        },
        {
          "id": "s-26f00o",
          "visual": "v-26f00k",
          "number": "",
          "body": "Together they account for roughly **330,000 deaths**. Here is the record, place by place.",
          "align": "left",
          "state": {}
        }
      ]
    },
